rules_version = '2';

// Contrato: specs/001-catalog-rbac/contracts/firestore-rules.md
//
// Las reglas responden solo dos preguntas: ¿tenés membresía activa en este comercio? y ¿sos su
// Propietario? Los permisos granulares se verifican en las Cloud Functions, que son las únicas
// que escriben. La pertenencia se lee de la membresía —no de un claim— porque una cuenta puede
// estar en varios comercios (FR-005) y la baja tiene que cortar el acceso de inmediato (FR-008a).
//
// ── POR QUÉ NO HAY UN COMODÍN `{document=**}` BAJO EL INQUILINO ──────────────────────────────────
// Firestore combina con OR todas las reglas que coinciden con un documento, SIN importar el orden
// en que están escritas. Un `match /tenants/{tenantId}/{document=**}` con `allow read` para
// miembros coincide también con `config/secrets` y `auditLog`, y concede su lectura a cualquier
// colaborador — por más que una regla más específica diga "solo el Propietario". Por eso cada
// colección legible está declarada de forma explícita, y todo lo que no esté listado queda
// denegado. Prueba de regresión: tests/rules/member-cannot-read-owner-paths.spec.ts
service cloud.firestore {
  match /databases/{database}/documents {

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function member(tenantId) {
      return get(membershipPath(tenantId)).data;
    }

    function isActiveMember(tenantId) {
      return request.auth != null
        && exists(membershipPath(tenantId))
        && member(tenantId).status == 'active';
    }

    function isOwnerOf(tenantId) {
      return isActiveMember(tenantId) && member(tenantId).isOwner == true;
    }

    // Lee el rol de la membresía: +1 lectura. Solo lo usa la ruta de costos (T068).
    function hasPermission(tenantId, permission) {
      return isActiveMember(tenantId)
        && permission in get(/databases/$(database)/documents/tenants/$(tenantId)/roles/$(member(tenantId).roleId)).data.permissions;
    }

    match /tenants/{tenantId} {

      // ── Legible por miembros activos ───────────────────────────────────────────────────────
      // El documento del comercio: nombre, moneda y estado. Esta regla alcanza solo a este
      // documento, no a sus subcolecciones.
      allow read: if isActiveMember(tenantId);

      match /products/{productId} {
        allow read: if isActiveMember(tenantId);

        match /variants/{variantId} {
          allow read: if isActiveMember(tenantId);
        }

        // Costos: documento aparte porque Firestore no protege campos sueltos (FR-015). Lo lee el
        // Propietario o un rol con `variant.cost.read` (T068); ningún otro permiso lo abre (caso 34).
        match /private/{docId} {
          allow read: if isOwnerOf(tenantId) || hasPermission(tenantId, 'variant.cost.read');
        }
      }

      match /roles/{roleId} {
        allow read: if isActiveMember(tenantId);
      }

      // Cada cuenta lee su propia membresía (para conocer su estado y su rol); el Propietario
      // lee todas.
      match /members/{memberUid} {
        allow read: if (request.auth != null && request.auth.uid == memberUid)
          || isOwnerOf(tenantId);
      }

      // ── Solo el Propietario ────────────────────────────────────────────────────────────────
      match /invitations/{invitationId} {
        allow read: if isOwnerOf(tenantId);
      }

      // Credenciales de pasarelas y facturación (FR-014)
      match /config/{docId} {
        allow read: if isOwnerOf(tenantId);
      }

      // Bitácora (FR-032, FR-034). No hay `allow create/update/delete` en ningún lado: nadie
      // escribe desde un cliente, ni el Propietario. El Admin SDK de las Functions evade estas
      // reglas por diseño. Tampoco la abre `audit.read`: las entradas incluyen cambios de costo, y
      // un rol sin `variant.cost.read` los vería (FR-015). Prueba: tests/rules/audit-read.spec.ts
      match /auditLog/{entryId} {
        allow read: if isOwnerOf(tenantId);
      }

      match /securityEvents/{eventId} {
        allow read: if isOwnerOf(tenantId);
      }

      // `skuIndex` no se declara: lo consulta solo el servidor.

      // ── 002: catálogo de cara a la tienda (specs/002-storefront-catalog/contracts/firestore-rules.md)
      // El árbol de categorías, las secciones destacadas y el vocabulario: lo que el panel necesita
      // para operar el catálogo, legible por cualquier miembro activo (FR-002 de la 002). Los tres
      // documentos se nombran: uno nuevo en esta colección —configuración de la tienda reservada al
      // Propietario, por ejemplo— no queda legible por heredar esta regla. Misma lección que el
      // comodín de arriba.
      match /storefront/{docId} {
        allow read: if isActiveMember(tenantId)
          && docId in ['categoryTree', 'sections', 'vocabulary'];
      }

      // Las URL amigables son públicas por naturaleza: el panel las lee para mostrar la URL libre
      // antes de guardar (FR-007 de la 002). De a una: `get`, nunca `list`.
      match /slugIndex/{slug} {
        allow get: if isActiveMember(tenantId);
      }

      // `gtinIndex` no se declara: lo consulta solo el servidor, como `skuIndex`.
    }

    // Los comercios de una cuenta (T075): consulta de grupo sobre todas las `members`, solo si
    // filtra por el uid de quien consulta. Este comodín coincide únicamente con documentos de
    // `members` y solo concede `list` de membresías propias, que ya eran legibles una por una: no
    // se superpone con ninguna ruta reservada. Prueba: tests/rules/my-tenants.spec.ts
    match /{path=**}/members/{memberUid} {
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Ninguna regla de este archivo concede `write`. Todo lo no listado queda denegado.
  }
}
